POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

APP_ENV=dev

# Trained artifacts, loaded once at startup. Produced by scripts/run_pipeline.py.
MODEL_PATH=artifacts/xgboost_model.json
MODEL_METADATA_PATH=artifacts/model_metadata.json
# When true, a missing model fails startup rather than letting the service run
# without the thing it exists to serve. Set false to work on the payment path
# before a model has been trained.
REQUIRE_MODEL=true

# Integration tests use a separate database so they can never disturb the
# generated dataset. Defaults to POSTGRES_DB with a _test suffix.
# TEST_DATABASE_URL=postgresql+psycopg://vault:change-me@localhost:5432/vault_test
